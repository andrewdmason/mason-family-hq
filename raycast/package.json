{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "family-todos",
  "title": "Family Todos",
  "description": "Quick-capture to-dos into Mason Family HQ",
  "icon": "icon.png",
  "author": "andrew",
  "license": "MIT",
  "private": true,
  "commands": [
    {
      "name": "add-task",
      "title": "Add To-Do",
      "description": "Capture a to-do into a family member's Inbox",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiUrl",
      "type": "textfield",
      "required": true,
      "title": "Family HQ URL",
      "description": "Base URL of the app, no trailing slash",
      "placeholder": "https://your-deployment.example.com"
    },
    {
      "name": "apiToken",
      "type": "password",
      "required": true,
      "title": "API Token",
      "description": "Personal token from Todos → Integrations (/todos/settings)"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.88.4",
    "@raycast/utils": "^1.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "lint": "ray lint"
  }
}
