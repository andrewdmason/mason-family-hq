# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# playwright
.playwright-mcp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Conductor local repository settings
.conductor/settings.local.toml
.conductor/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raycast extension build artifacts
/raycast/node_modules/
/raycast/dist/

# chrome reader extension build artifacts
/extension/node_modules/
/extension/dist/
# extension signing key — NEVER commit; defines the permanent extension ID.
# Back it up to 1Password (covered by the global *.pem rule above; explicit here).
/extension/key.pem
# stray crx from an accidental crx3 CLI run — the real output goes to public/extension/
/extension/*.crx

# Baseball importer capture cache + browser profile (local, never committed)
scripts/baseball/.cache/
